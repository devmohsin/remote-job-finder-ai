# Copy this file and rename it to .env
# Then fill in your actual API keys

# AI API Key (required)
# Get it from your API provider dashboard
ANTHROPIC_API_KEY=your_api_key_here

# Remotive API (Free - No key needed)
# RemoteOK API (Free - No key needed)

# Optional: Adzuna API (Free tier - 1000 calls/month)
# Get it from: https://developer.adzuna.com
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_API_KEY=your_adzuna_api_key_here
